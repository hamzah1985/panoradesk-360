{
  "name": "panoradesk-360",
  "productName": "PanoraDesk 360",
  "version": "1.2.1",
  "private": true,
  "description": "Desktop editor for building interactive 360° virtual tours from panorama photos, exporting self-contained websites that run offline.",
  "keywords": [
    "360",
    "panorama",
    "virtual-tour",
    "photo-sphere-viewer",
    "electron",
    "equirectangular"
  ],
  "homepage": "https://github.com/hamzah1985/panoradesk-360",
  "repository": {
    "type": "git",
    "url": "https://github.com/hamzah1985/panoradesk-360.git"
  },
  "bugs": {
    "url": "https://github.com/hamzah1985/panoradesk-360/issues"
  },
  "license": "MIT",
  "author": "PanoraDesk",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist release",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "vendor:bundle": "node scripts/bundle-vendor.mjs",
    "prepare": "node scripts/bundle-vendor.mjs",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "npm run icons:generate && npm run vendor:bundle && npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@photo-sphere-viewer/autorotate-plugin": "^5.14.1",
    "@photo-sphere-viewer/core": "^5.14.1",
    "@photo-sphere-viewer/gallery-plugin": "^5.14.1",
    "@photo-sphere-viewer/gyroscope-plugin": "^5.14.1",
    "@photo-sphere-viewer/markers-plugin": "^5.14.1",
    "@photo-sphere-viewer/stereo-plugin": "^5.14.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "png-to-ico": "^3.0.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "rimraf": "^6.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.14",
    "three": "^0.184.0",
    "typescript": "~5.8.2",
    "uuid": "^14.0.0",
    "vite": "^6.2.3",
    "wait-on": "^8.0.3",
    "zustand": "^5.0.13"
  },
  "build": {
    "appId": "com.panoradesk.editor",
    "productName": "PanoraDesk 360",
    "executableName": "PanoraDesk360",
    "icon": "build/icon.ico",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!node_modules/@img/sharp-wasm32/**",
      "!node_modules/@emnapi/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "shortcutName": "PanoraDesk 360",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "uninstallDisplayName": "PanoraDesk 360"
    }
  }
}
