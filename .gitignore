# Dependencies
node_modules/

# Build output
dist/
dist-electron/
release/
coverage/

# Generated icons.
# build/installer.nsh is hand-written and MUST stay tracked — electron-builder
# reads it via the nsis.include option, so ignoring all of build/ would break a
# fresh clone. Only the generated icons are ignored here.
build/icon.ico
build/icon.png
build/icon.svg

# Generated by `npm run vendor:bundle` (wired to the prepare script)
electron/vendor/

# Local project data and scratch output
tmp/
projects_data/
uploads/
*.asar

# Environment and secrets
.env
.env.*

# Editor / OS
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# Local agent settings — these hold machine-specific absolute paths
.claude/
